// AMRA-V1 — LikeC4 architecture intent model (RECOVERED 2026-08-09)
// Role: SEMANTIC / DEPLOYMENT / TRUST INTENT — human curated.
// As-built structure lives in Spring Modulith generated C4:
//   docs/architecture/maps/generated/modulith/ (GENERATED — DO NOT EDIT)
// This file is NOT a manual copy of the Spring module graph.
// Authorities frozen: PRV2 (PluginRuntime), UWEV1-ARSF (Workflow Execution TARGET), W2 (Definition), EUMF (Usage), APPD (Security).

specification {
  element system
  element container
  element component
  element person
  element external
}

model {

  user = person 'User' {
    description 'Platform user'
  }

  reviewer = person 'Human Reviewer' {
    description 'Final arbiter'
  }

  cloudflare = external 'Cloudflare' {
    description 'R2, Pages, AI Gateway'
  }

  telegram = external 'Telegram' {
    description 'Notifications'
  }

  aiProviders = external 'AI Providers' {
    description 'MiMo, LongCat, OpenRouter, etc.'
  }

  storage = external 'Storage' {
    description 'Object storage / shared filesystem'
  }

  postgres = external 'PostgreSQL' {
    description 'Primary product database'
  }

  mediaPlatform = system 'media-platform' {
    description 'Media platform'

    // ── Deployment units ──────────────────────────────────────────────
    platformApp = container 'platform-app' {
      description 'Canonical Spring Boot entry point (PlatformApplication)'
    }

    sandboxWorker = container 'sandbox-worker' {
      description 'DEPLOYMENT / SECURITY / PROCESS ISOLATION BOUNDARY — code sandbox execution worker (SandboxWorkerApplication)'
    }

    remoteRenderWorker = container 'remote-render-worker' {
      description 'CURRENT deployment unit / render-specific adapter (RemoteRenderWorkerApplication). TARGET: THIN deployment adapter (PMPR)'
    }

    // ── Workflow (Definition PUBLISHED / Execution TARGET UWEV1) ─────
    workflowDefinition = container 'Workflow Definition' {
      description 'W2 PUBLISHED/CLOSED — declarative DAG definitions (ACTION/EXTENSION_POINT/CONDITION/APPROVAL/DELAY/NOTIFICATION/WEBHOOK/HOOK)'
    }

    workflowExecution = container 'Workflow Execution' {
      description 'CURRENT (UWEV1-FV1 foundation): execution authority workflow-module; WorkflowExecution + workflow_execution table; PUBLISHED-only version-pinned start; Temporal durable orchestration; ACTION/EXTENSION_POINT -> PluginRuntime. DEFERRED: full plan-walk, HOOK execution, node-level persistence, compensation'
    }

    temporal = container 'Temporal' {
      description 'DURABLE ORCHESTRATION AUTHORITY — sole durable orchestrator (render pipeline active; generic execution TARGET)'
    }

    // ── Runtime authority ─────────────────────────────────────────────
    pluginRuntime = container 'PluginRuntime' {
      description 'CANONICAL EFFECT EXECUTION AUTHORITY (PRV2 PUBLISHED) — DefaultPluginRuntime; extension::runtime; TRUSTED_IN_PROCESS + untrusted DENY'
    }

    capabilityRegistry = container 'Capability Registry' {
      description 'METADATA / MATCHING / HEALTH AUTHORITY ONLY (Model B) — never executes providers'
    }

    providers = container 'Providers' {
      description 'Provider SPI / adapters (ProviderExtensionSPI compatibility; domain provider ports)'
    }

    // ── Policy / auth ─────────────────────────────────────────────────
    policyAuth = container 'Policy / Auth' {
      description 'APPD: CanonicalActor, tenant default deny, typed AuthorizationDecision, RBAC'
    }

    entitlement = container 'Entitlement' {
      description 'Entitlement authority'
    }

    featureFlags = container 'Feature Flags' {
      description 'OpenFeature — rollout / routing policy only (NOT security/execution authority)'
    }

    quota = container 'Quota' {
      description 'Quota authority (quota-billing-module — PMPR candidate)'
    }

    // ── Data authorities ──────────────────────────────────────────────
    artifactProvenance = container 'Artifact / Provenance' {
      description 'ArtifactRef + provenance authority (artifact-module)'
    }

    usage = container 'Usage' {
      description 'EUMF PUBLISHED — UsageRecord via UsageRecordEmissionPort (REQUEST+DURATION; OperationRef+attempt idempotency)'
    }

    providerCost = container 'ProviderCost' {
      description 'ProviderCostObservation (REPORTED/ESTIMATED/DERIVED) — runtime != pricing/billing'
    }

    storageModule = container 'storage-module' {
      description 'Storage delivery + materialization (CURRENT: Artifact->Render->Storage SPI debt; TARGET: Artifact->Storage API/SPI — PMPR)'
    }

    // ── Other CURRENT containers (aggregate) ──────────────────────────
    renderModule = container 'render-module' {
      description 'Core render domain (CURRENT; legacy provider-bound paths remain)'
    }

    aiModule = container 'ai-module' {
      description 'AI integration (ChatProvider domain port; EUMF producer)'
    }

    sandboxRuntime = container 'sandbox-runtime-module' {
      description 'Code sandbox runtime (CURRENT; PMPR MERGE/RETIRE review candidate)'
    }

    outbox = container 'Outbox' {
      description 'Durable outbox events (outbox-event-module)'
    }

    pmprCandidates = container 'PMPR CANDIDATES' {
      description 'artifact-catalog-module, quota-billing-module, product-layer-module, compatibility-migration-module — CURRENT elements with PMPR governance; NOT prematurely removed'
    }

    scheduler = container 'Scheduler' {
      description 'TRIGGER AUTHORITY ONLY — requests workflow execution; owns no execution/node/retry'
    }
  }

  // ── External relationships ──────────────────────────────────────────
  user -> mediaPlatform 'uses'
  reviewer -> mediaPlatform 'reviews'
  mediaPlatform -> storage 'reads/writes (CURRENT via render-bound path — DEBT)'
  mediaPlatform -> postgres 'persists product state'
  mediaPlatform -> aiProviders 'calls models'
  mediaPlatform -> cloudflare 'R2/Pages/AI Gateway'

  // ── Deployment relationships ────────────────────────────────────────
  platformApp -> sandboxWorker 'isolates code execution'
  platformApp -> remoteRenderWorker 'dispatches render jobs (CURRENT)'

  // ── Workflow chain (TARGET for UWEV1 — frozen intent, NOT implemented) ──
  workflowDefinition -> workflowExecution 'definition/version pinned'
  workflowExecution -> temporal 'durable orchestration'
  temporal -> pluginRuntime 'Activity/effect boundary'
  pluginRuntime -> providers 'effect execution'
  pluginRuntime -> capabilityRegistry 'resolves capability'
  providers -> artifactProvenance 'produces artifacts'
  providers -> usage 'emits usage (EUMF)'
  providers -> providerCost 'reports cost'
  workflowExecution -> outbox 'terminal transitions (TARGET)'

  // ── Security / policy chain ─────────────────────────────────────────
  policyAuth -> entitlement 'authorizes'
  policyAuth -> featureFlags 'rollout policy'
  policyAuth -> quota 'enforces limits'
  scheduler -> policyAuth 'system actor policy'

  // ── Runtime semantics ───────────────────────────────────────────────
  // Forbidden (never drawn as target): Workflow -> ProviderExtensionSPI; Workflow -> SandboxExecutionService.
  capabilityRegistry -> pluginRuntime 'describes; runtime executes (CAPABILITY_REGISTRY_DESCRIBES; PLUGIN_RUNTIME_EXECUTES)'

  // ── Data authorities ────────────────────────────────────────────────
  artifactProvenance -> storageModule 'CURRENT DEBT: via render; TARGET: direct Storage API/SPI (PMPR)'
  usage -> postgres 'persists usage records'
}

views {
  view systemContext of mediaPlatform {
    title 'System Context'
    include *
  }

  view deploymentBoundaries of mediaPlatform {
    title 'Deployment / Trust Boundaries'
    include
      platformApp,
      sandboxWorker,
      remoteRenderWorker,
      sandboxRuntime,
      temporal
  }

  view workflowExecutionTarget of mediaPlatform {
    title 'Workflow Execution (CURRENT foundation — UWEV1-FV1; remaining scope TARGET)'
    include
      workflowDefinition,
      workflowExecution,
      temporal,
      pluginRuntime,
      capabilityRegistry,
      providers,
      artifactProvenance,
      usage,
      providerCost,
      outbox
  }

  view runtimeAuthority of mediaPlatform {
    title 'Runtime Authority (PRV2 published)'
    include
      capabilityRegistry,
      pluginRuntime,
      providers,
      usage,
      providerCost
  }

  view policyAndData of mediaPlatform {
    title 'Policy / Data Authorities'
    include
      policyAuth,
      entitlement,
      featureFlags,
      quota,
      artifactProvenance,
      usage,
      providerCost,
      storageModule,
      outbox
  }
}
