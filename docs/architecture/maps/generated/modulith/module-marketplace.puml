@startuml
title <size:24>Marketplace</size>

set separator none
top to bottom direction

<style>
  root {
    BackgroundColor: #ffffff
    FontColor: #444444
  }
</style>

!include <C4/C4>
!include <C4/C4_Context>
!include <C4/C4_Component>

System_Boundary("PlatformApplication_boundary", "PlatformApplication", $tags="") {
  Container_Boundary("PlatformApplication.PlatformApplication_boundary", "PlatformApplication", $tags="") {
    Component(PlatformApplication.PlatformApplication.IdentityAccess, "Identity & Access", $techn="Module", $descr="", $tags="", $link="")
    Component(PlatformApplication.PlatformApplication.Marketplace, "Marketplace", $techn="Module", $descr="", $tags="", $link="")
    Component(PlatformApplication.PlatformApplication.Media, "Media", $techn="Module", $descr="", $tags="", $link="")
    Component(PlatformApplication.PlatformApplication.OutboxEvents, "Outbox & Events", $techn="Module", $descr="", $tags="", $link="")
    Component(PlatformApplication.PlatformApplication.SharedKernel, "Shared Kernel", $techn="Module", $descr="", $tags="", $link="")
  }

}

Rel(PlatformApplication.PlatformApplication.IdentityAccess, PlatformApplication.PlatformApplication.SharedKernel, "depends on", $techn="", $tags="", $link="")
Rel(PlatformApplication.PlatformApplication.Marketplace, PlatformApplication.PlatformApplication.IdentityAccess, "uses", $techn="", $tags="", $link="")
Rel(PlatformApplication.PlatformApplication.Marketplace, PlatformApplication.PlatformApplication.Media, "uses", $techn="", $tags="", $link="")
Rel(PlatformApplication.PlatformApplication.Marketplace, PlatformApplication.PlatformApplication.OutboxEvents, "uses", $techn="", $tags="", $link="")
Rel(PlatformApplication.PlatformApplication.Marketplace, PlatformApplication.PlatformApplication.SharedKernel, "depends on", $techn="", $tags="", $link="")
Rel(PlatformApplication.PlatformApplication.Media, PlatformApplication.PlatformApplication.IdentityAccess, "uses", $techn="", $tags="", $link="")
Rel(PlatformApplication.PlatformApplication.Media, PlatformApplication.PlatformApplication.SharedKernel, "depends on", $techn="", $tags="", $link="")
Rel(PlatformApplication.PlatformApplication.OutboxEvents, PlatformApplication.PlatformApplication.SharedKernel, "depends on", $techn="", $tags="", $link="")

SHOW_LEGEND(true)
hide stereotypes
@enduml
