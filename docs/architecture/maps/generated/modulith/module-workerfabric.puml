Rel(PlatformApplication.PlatformApplication.Workerfabric, PlatformApplication.PlatformApplication.SandboxIsolation, "depends on", $techn="", $tags="", $link="")
Rel(PlatformApplication.PlatformApplication.Workerfabric, PlatformApplication.PlatformApplication.SharedKernel, "depends on", $techn="", $tags="", $link="")
Rel(PlatformApplication.PlatformApplication.Workerfabric, PlatformApplication.PlatformApplication.Storage, "depends on", $techn="", $tags="", $link="")

SHOW_LEGEND(true)
hide stereotypes
@enduml
