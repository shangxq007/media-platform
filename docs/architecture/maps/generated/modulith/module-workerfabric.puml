    Component(PlatformApplication.PlatformApplication.Execution, "Execution", $techn="Module", $descr="", $tags="", $link="")
    Component(PlatformApplication.PlatformApplication.SandboxIsolation, "Sandbox Isolation", $techn="Module", $descr="", $tags="", $link="")
    Component(PlatformApplication.PlatformApplication.SharedKernel, "Shared Kernel", $techn="Module", $descr="", $tags="", $link="")
    Component(PlatformApplication.PlatformApplication.Storage, "Storage", $techn="Module", $descr="", $tags="", $link="")
    Component(PlatformApplication.PlatformApplication.Workerfabric, "Workerfabric", $techn="Module", $descr="", $tags="", $link="")
    Component(PlatformApplication.PlatformApplication.Artifact, "Artifact", $techn="Module", $descr="", $tags="", $link="")
  }

}

Rel(PlatformApplication.PlatformApplication.Artifact, PlatformApplication.PlatformApplication.SharedKernel, "depends on", $techn="", $tags="", $link="")
Rel(PlatformApplication.PlatformApplication.Artifact, PlatformApplication.PlatformApplication.Storage, "uses", $techn="", $tags="", $link="")
Rel(PlatformApplication.PlatformApplication.Execution, PlatformApplication.PlatformApplication.SharedKernel, "depends on", $techn="", $tags="", $link="")
Rel(PlatformApplication.PlatformApplication.Storage, PlatformApplication.PlatformApplication.SharedKernel, "depends on", $techn="", $tags="", $link="")
Rel(PlatformApplication.PlatformApplication.Workerfabric, PlatformApplication.PlatformApplication.Artifact, "depends on", $techn="", $tags="", $link="")
