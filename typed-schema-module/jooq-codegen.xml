<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<configuration xmlns="http://www.jooq.org/xsd/jooq-codegen-3.21.0.xsd">
  <jdbc>
    <driver>org.postgresql.Driver</driver>
    <url>__JOOQ_JDBC_URL__</url>
    <user>__JOOQ_DB_USER__</user>
    <password>__JOOQ_DB_AUTH__</password>
  </jdbc>
  <generator>
    <name>org.jooq.codegen.JavaGenerator</name>
    <database>
      <name>org.jooq.meta.postgres.PostgresDatabase</name>
      <includes>.*</includes>
      <excludes>flyway_schema_history</excludes>
      <schemata>
        <schema><inputSchema>analytics</inputSchema></schema>
        <schema><inputSchema>artifacts</inputSchema></schema>
        <schema><inputSchema>billing</inputSchema></schema>
        <schema><inputSchema>commerce</inputSchema></schema>
        <schema><inputSchema>composition</inputSchema></schema>
        <schema><inputSchema>publication</inputSchema></schema>
        <schema><inputSchema>entitlement</inputSchema></schema>
        <schema><inputSchema>execution</inputSchema></schema>
        <schema><inputSchema>extension</inputSchema></schema>
        <schema><inputSchema>identity</inputSchema></schema>
        <schema><inputSchema>infrastructure</inputSchema></schema>
        <schema><inputSchema>marketplace</inputSchema></schema>
        <schema><inputSchema>media</inputSchema></schema>
        <schema><inputSchema>notification</inputSchema></schema>
        <schema><inputSchema>payment</inputSchema></schema>
        <schema><inputSchema>policy</inputSchema></schema>
        <schema><inputSchema>prompt</inputSchema></schema>
        <schema><inputSchema>render</inputSchema></schema>
        <schema><inputSchema>storage</inputSchema></schema>
        <schema><inputSchema>timeline</inputSchema></schema>
        <schema><inputSchema>worker_fabric</inputSchema></schema>
        <schema><inputSchema>workflow</inputSchema></schema>
      </schemata>
      <forcedTypes>
        <!-- TIMESTAMPTZ → Instant via InstantConverter -->
        <forcedType>
          <userType>java.time.Instant</userType>
          <converter>com.example.platform.typedschema.contract.InstantConverter</converter>
          <includeTypes>.*TIMESTAMPTZ.*</includeTypes>
        </forcedType>
        <!-- TSVECTOR → TsvectorValue via TsvectorBinding -->
        <forcedType>
          <userType>com.example.platform.typedschema.contract.TsvectorValue</userType>
          <binding>com.example.platform.typedschema.contract.TsvectorBinding</binding>
          <includeTypes>.*tsvector.*</includeTypes>
        </forcedType>
      </forcedTypes>
    </database>
    <generate><generatedAnnotationDate>false</generatedAnnotationDate></generate>
    <target>
      <packageName>com.example.platform.typedschema.jooq.generated</packageName>
      <directory>src/main/java</directory>
    </target>
  </generator>
</configuration>
