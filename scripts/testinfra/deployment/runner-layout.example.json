{
  "version": 1,
  "runner_id": "OWNER_SELECT_DEDICATED_LINUX_RUNNER",
  "manager": "OWNER_NOMINATED_RUNNER_ADMIN",
  "principals": {
    "admin": 0,
    "control": 61001,
    "executor": 0,
    "test": 61003
  },
  "paths": {
    "runtime": "/opt/media-platform/testinfra",
    "policy": "/etc/media-platform/testinfra/policy",
