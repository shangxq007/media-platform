# Dedicated Activity host. This is intentionally separate from the API image.
# The base digest and tool pins must be supplied by the release build manifest.
# Keep the worker final stage independent from the API image. The API image
# advertises 8080/tcp; this JRE base has no exposed ports.
ARG BASE_IMAGE=docker.io/library/eclipse-temurin@sha256:abed22bb0186ab4554c339fa41e0a361daed337b938929c95a1f2e4a228c1935
FROM ${BASE_IMAGE}

USER 0
ARG FFMPEG_VERSION=7:4.4.2-0ubuntu0.22.04.1
ARG BUBBLEWRAP_VERSION=0.6.1-1ubuntu0.3
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      ffmpeg=${FFMPEG_VERSION} \
      bubblewrap=${BUBBLEWRAP_VERSION} \
 && rm -rf /var/lib/apt/lists/* /var/cache/apt/* \
 && test -x /usr/bin/ffmpeg \
 && test -x /usr/bin/ffprobe \
 && test -x /usr/bin/bwrap

RUN groupadd --system spring \
 && useradd --system --gid spring --uid 10001 spring

COPY platform-thumbnail-worker.jar /app/platform-thumbnail-worker.jar
RUN chown spring:spring /app/platform-thumbnail-worker.jar

USER spring:spring
ENV SPRING_PROFILES_ACTIVE=dev,temporal,thumbnail-worker \
    SPRING_MAIN_WEB_APPLICATION_TYPE=none \
    SPRING_TEMPORAL_START_WORKERS=true \
    PLATFORM_RUNTIME_ROLE=WORKER \
    APP_TEMPORAL_TASK_QUEUE=media-platform-tasks \
    THUMBNAIL_BWRAP_PATH=/usr/bin/bwrap \
    THUMBNAIL_FFMPEG_PATH=/usr/bin/ffmpeg \
    THUMBNAIL_FFPROBE_PATH=/usr/bin/ffprobe

ENTRYPOINT ["java", "-jar", "/app/platform-thumbnail-worker.jar"]
