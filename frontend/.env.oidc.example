# Frontend OIDC build-time fallback (see frontend/src/auth/oidcConfig.ts).
#
# The committed bundle is environment-independent: the backend serves the deployment
# issuer/audience at /config.js, and the SPA reads window.__MEDIA_PLATFORM_CONFIG__.
# These build-time values are only needed when the bundle is served WITHOUT that
# endpoint (e.g. a standalone static hosting or the Vite dev server).
#
# Copy to frontend/.env.local (gitignored) or export before `npm run build:oidc`.
# Never commit real client secrets here; the browser only needs the public client id.

# Issuer of the OIDC provider, with or without a trailing slash.
VITE_OIDC_ISSUER=https://auth.example.com/application/o/media-platform/

# Public OAuth2 client id (the API audience).
VITE_OIDC_CLIENT_ID=media-platform

# Optional: defaults to `${window.location.origin}/oauth/callback`.
# VITE_OIDC_REDIRECT_URI=https://app.example.com/oauth/callback

# Optional: defaults to `openid profile email`.
# VITE_OIDC_SCOPE=openid profile email
