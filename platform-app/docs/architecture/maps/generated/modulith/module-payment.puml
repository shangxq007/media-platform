@startuml
title <size:24>Payment</size>

set separator none
top to bottom direction

<style>
  root {
    BackgroundColor: #ffffff
    FontColor: #444444
  }
</style>

!include <C4/C4>
!include <C4/C4_Context>
!include <C4/C4_Component>

System_Boundary("PlatformApplication_boundary", "PlatformApplication", $tags="") {
  Container_Boundary("PlatformApplication.PlatformApplication_boundary", "PlatformApplication", $tags="") {
    Component(PlatformApplication.PlatformApplication.Commerce, "Commerce", $techn="Module", $descr="", $tags="", $link="")
    Component(PlatformApplication.PlatformApplication.Payment, "Payment", $techn="Module", $descr="", $tags="", $link="")
    Component(PlatformApplication.PlatformApplication.SharedKernel, "Shared Kernel", $techn="Module", $descr="", $tags="", $link="")
    Component(PlatformApplication.PlatformApplication.Typedschema, "Typedschema", $techn="Module", $descr="", $tags="", $link="")
  }

}

Rel(PlatformApplication.PlatformApplication.Commerce, PlatformApplication.PlatformApplication.SharedKernel, "depends on", $techn="", $tags="", $link="")
Rel(PlatformApplication.PlatformApplication.Commerce, PlatformApplication.PlatformApplication.Typedschema, "depends on", $techn="", $tags="", $link="")
Rel(PlatformApplication.PlatformApplication.Payment, PlatformApplication.PlatformApplication.SharedKernel, "depends on", $techn="", $tags="", $link="")
Rel(PlatformApplication.PlatformApplication.Payment, PlatformApplication.PlatformApplication.Typedschema, "depends on", $techn="", $tags="", $link="")
Rel(PlatformApplication.PlatformApplication.Payment, PlatformApplication.PlatformApplication.Commerce, "uses", $techn="", $tags="", $link="")

SHOW_LEGEND(true)
hide stereotypes
@enduml