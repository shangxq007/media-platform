@startuml
title <size:24>Production</size>

set separator none
top to bottom direction

<style>
  root {
    BackgroundColor: #ffffff
    FontColor: #444444
  }
</style>

!include <C4/C4>
!include <C4/C4_Context>
!include <C4/C4_Component>

System_Boundary("PlatformApplication_boundary", "PlatformApplication", $tags="") {
  Container_Boundary("PlatformApplication.PlatformApplication_boundary", "PlatformApplication", $tags="") {
    Component(PlatformApplication.PlatformApplication.Commerce, "Commerce", $techn="Module", $descr="", $tags="", $link="")
    Component(PlatformApplication.PlatformApplication.PolicyGovernance, "Policy Governance", $techn="Module", $descr="", $tags="", $link="")
    Component(PlatformApplication.PlatformApplication.Production, "Production", $techn="Module", $descr="", $tags="", $link="")
    Component(PlatformApplication.PlatformApplication.Security, "Security", $techn="Module", $descr="", $tags="", $link="")
    Component(PlatformApplication.PlatformApplication.App, "App", $techn="Module", $descr="", $tags="", $link="")
    Component(PlatformApplication.PlatformApplication.Billing, "Billing", $techn="Module", $descr="", $tags="", $link="")
  }

}

Rel(PlatformApplication.PlatformApplication.Commerce, PlatformApplication.PlatformApplication.Billing, "uses", $techn="", $tags="", $link="")
Rel(PlatformApplication.PlatformApplication.Production, PlatformApplication.PlatformApplication.Billing, "depends on", $techn="", $tags="", $link="")
Rel(PlatformApplication.PlatformApplication.Production, PlatformApplication.PlatformApplication.Commerce, "depends on", $techn="", $tags="", $link="")
Rel(PlatformApplication.PlatformApplication.Production, PlatformApplication.PlatformApplication.PolicyGovernance, "depends on", $techn="", $tags="", $link="")
Rel(PlatformApplication.PlatformApplication.Production, PlatformApplication.PlatformApplication.Security, "uses", $techn="", $tags="", $link="")
Rel(PlatformApplication.PlatformApplication.Production, PlatformApplication.PlatformApplication.App, "uses", $techn="", $tags="", $link="")

SHOW_LEGEND(true)
hide stereotypes
@enduml