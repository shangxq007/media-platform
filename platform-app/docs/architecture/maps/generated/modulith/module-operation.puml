@startuml
title <size:24>Operation</size>

set separator none
top to bottom direction

<style>
  root {
    BackgroundColor: #ffffff
    FontColor: #444444
  }
</style>

!include <C4/C4>
!include <C4/C4_Context>
!include <C4/C4_Component>

System_Boundary("PlatformApplication_boundary", "PlatformApplication", $tags="") {
  Container_Boundary("PlatformApplication.PlatformApplication_boundary", "PlatformApplication", $tags="") {
    Component(PlatformApplication.PlatformApplication.Fonttext, "Fonttext", $techn="Module", $descr="", $tags="", $link="")
    Component(PlatformApplication.PlatformApplication.Operation, "Operation", $techn="Module", $descr="", $tags="", $link="")
    Component(PlatformApplication.PlatformApplication.SharedKernel, "Shared Kernel", $techn="Module", $descr="", $tags="", $link="")
    Component(PlatformApplication.PlatformApplication.Timeline, "Timeline", $techn="Module", $descr="", $tags="", $link="")
    Component(PlatformApplication.PlatformApplication.Audio, "Audio", $techn="Module", $descr="", $tags="", $link="")
  }

}

Rel(PlatformApplication.PlatformApplication.Operation, PlatformApplication.PlatformApplication.Audio, "depends on", $techn="", $tags="", $link="")
Rel(PlatformApplication.PlatformApplication.Operation, PlatformApplication.PlatformApplication.Fonttext, "depends on", $techn="", $tags="", $link="")
Rel(PlatformApplication.PlatformApplication.Operation, PlatformApplication.PlatformApplication.SharedKernel, "depends on", $techn="", $tags="", $link="")
Rel(PlatformApplication.PlatformApplication.Operation, PlatformApplication.PlatformApplication.Timeline, "depends on", $techn="", $tags="", $link="")
Rel(PlatformApplication.PlatformApplication.Timeline, PlatformApplication.PlatformApplication.Audio, "depends on", $techn="", $tags="", $link="")
Rel(PlatformApplication.PlatformApplication.Timeline, PlatformApplication.PlatformApplication.Fonttext, "depends on", $techn="", $tags="", $link="")
Rel(PlatformApplication.PlatformApplication.Timeline, PlatformApplication.PlatformApplication.SharedKernel, "depends on", $techn="", $tags="", $link="")

SHOW_LEGEND(true)
hide stereotypes
@enduml
